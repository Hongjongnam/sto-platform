# HTTP
PORT=4780

# Reverse proxies in front of the app (0 when reached directly)
TRUST_PROXY=0

# PostgreSQL (infra/postgres)
DATABASE_URL=postgres://sto:sto@127.0.0.1:54320/sto

# Chain (infra/besu)
RPC_URL=http://127.0.0.1:8545
# Deployment record written by contracts/scripts/deploy.ts
DEPLOYMENT_FILE=../contracts/deployments/besu.json
# Custodial key store for local development: role and investor keys are derived from this
# mnemonic. This is the public development mnemonic; never use it outside a local network.
CHAIN_MNEMONIC=test test test test test test test test test test test junk

# Signing key for access tokens, at least 32 characters (openssl rand -base64 32)
JWT_SECRET=change-me-change-me-change-me-change-me
JWT_TTL=8h

# Public demo endpoints (/demo/*): one-click sign-in without a password and deliberate
# ledger corruption for the reconciliation walkthrough. Keep off outside a demo.
DEMO_MODE=off
